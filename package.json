{
  "name": "@mcp-abap-adt/auth-errors",
  "version": "3.0.1",
  "description": "The runtime half of the MCP ABAP ADT authentication error contract: builders, renderers, allowlist guards and classification for IAuthProviderError",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "shape-check": [
        "dist/shapeCheck/index.d.ts"
      ],
      "tables": [
        "dist/tables.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./shape-check": {
      "types": "./dist/shapeCheck/index.d.ts",
      "require": "./dist/shapeCheck/index.js",
      "default": "./dist/shapeCheck/index.js"
    },
    "./tables": {
      "types": "./dist/tables.d.ts",
      "require": "./dist/tables.js",
      "default": "./dist/tables.js"
    },
    "./package.json": "./package.json",
    "./tools/check-provider-shape.mjs": "./tools/check-provider-shape.mjs"
  },
  "files": [
    "dist",
    "tools/check-provider-shape.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "COPYING"
  ],
  "sideEffects": false,
  "keywords": [
    "abap",
    "sap",
    "adt",
    "authentication",
    "errors",
    "mcp",
    "abap-adt"
  ],
  "author": "Oleksii Kyslytsia <oleksij.kyslytsja@gmail.com>",
  "license": "LGPL-3.0-only",
  "homepage": "https://github.com/fr0ster/mcp-abap-adt-auth-errors#readme",
  "bugs": {
    "url": "https://github.com/fr0ster/mcp-abap-adt-auth-errors/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fr0ster/mcp-abap-adt-auth-errors.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node tools/remove.mjs dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "lint": "biome check --write src tools/check-provider-shape.mjs tools/remove.mjs tools/run-tests.mjs",
    "lint:check": "biome check --error-on-warnings src tools/check-provider-shape.mjs tools/remove.mjs tools/run-tests.mjs",
    "format": "biome format --write src",
    "build": "npm run --silent clean && biome check src --diagnostic-level=error && tsc -p tsconfig.build.json",
    "build:fast": "tsc -p tsconfig.build.json",
    "test": "npm run --silent test:build && node tools/run-tests.mjs",
    "test:build": "node tools/remove.mjs .test-build && tsc -p tsconfig.test.json",
    "test:file": "npm run --silent test:build && node tools/run-tests.mjs",
    "test:check": "tsc --noEmit",
    "docs:kinds": "npm run build && npm run test:file -- --env WRITE_README_TABLES=1 .test-build/__tests__/kindsTable.test.js",
    "test:shape": "npm run --silent test:build && node tools/run-tests.mjs .test-build/__tests__/shapeCheck.test.js",
    "prepublishOnly": "npm run build && npm run test:shape"
  },
  "engines": {
    "node": "^22 || ^24 || ^26"
  },
  "dependencies": {
    "@mcp-abap-adt/interfaces-auth": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.2"
  }
}
